{
  "name": "capitaine",
  "productName": "Capitaine",
  "version": "0.4.1",
  "description": "IDE IA-first : projets et terminaux",
  "main": "./out/main/index.js",
  "author": "Lucas Burlot",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "smoke": "node scripts/smoke.mjs",
    "release:patch": "npm version patch -m \"chore(release): v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"chore(release): v%s\" && git push --follow-tags"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.2.7",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.66.0",
    "marked": "^14.0.0",
    "monaco-editor": "^0.55.1",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "desktopName": "capitaine.desktop"
}
